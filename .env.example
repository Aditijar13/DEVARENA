# ── Server ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MongoDB Atlas ────────────────────────────────────────
# Get free cluster at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/devarena?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_32_char_random_string
JWT_REFRESH_SECRET=replace_with_another_32_char_random_string
JWT_EXPIRE=30d

# ── URLs (Render sets these automatically) ────────────────
# For local dev:
CLIENT_URL=http://localhost:5000
SERVER_URL=http://localhost:5000
# On Render, set both to your service URL e.g. https://devarena.onrender.com

# ── Cloudinary (free at cloudinary.com) ──────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth (console.cloud.google.com) ───────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email / SMTP (Gmail App Password) ────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# ── Stripe (optional — stripe.com) ───────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
